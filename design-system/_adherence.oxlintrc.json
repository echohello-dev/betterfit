{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/lists/**",
              "components/workout/**",
              "ui_kits/ios_app/**",
              "ui_kits/watch_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:BBH Hegarty))/i]",
        "message": "Font not provided by the design system. Available: BBH Hegarty."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|title|message|action|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: tone, icon, title, message, action, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|danger)$/]",
        "message": "<Banner> tone must be one of 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|fullWidth|icon|trailingIcon|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, fullWidth, icon, trailingIcon, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|radius|tone|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding, radius, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|raised|identity|outline)$/]",
        "message": "<Card> tone must be one of 'surface' | 'raised' | 'identity' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChevronRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|subtitle|iconTint|value|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ChevronRow> doesn't accept that prop. Declared props: icon, title, subtitle, iconTint, value, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: label, icon, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContributionHeatmap'] > JSXAttribute > JSXIdentifier[name!=/^(?:values|weeks|cell|gap|style|key|ref|className|style|children)$/]",
        "message": "<ContributionHeatmap> doesn't accept that prop. Declared props: values, weeks, cell, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:inset|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: inset, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropdownChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<DropdownChip> doesn't accept that prop. Declared props: label, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropdownChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<DropdownChip> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|message|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, message, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|prescription|muscles|state|isLast|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ExerciseRow> doesn't accept that prop. Declared props: index, name, prescription, muscles, state, isLast, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:planned|active|done)$/]",
        "message": "<ExerciseRow> state must be one of 'planned' | 'active' | 'done'."
