        "selector": "JSXOpeningElement[name.name='WorkoutCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|focus|exercises|duration|volume|muscles|tone|badge|onClick|style|key|ref|className|style|children)$/]",
