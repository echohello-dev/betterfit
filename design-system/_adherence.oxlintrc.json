        "selector": "JSXOpeningElement[name.name='PhotoSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|width|height|radius|label|style|key|ref|className|style|children)$/]",
        "message": "<PhotoSlot> doesn't accept that prop. Declared props: src, alt, width, height, radius, label, style."
