        "selector": "JSXOpeningElement[name.name='OverviewStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|label|tint|style|key|ref|className|style|children)$/]",
        "message": "<OverviewStat> doesn't accept that prop. Declared props: icon, value, label, tint, style."
