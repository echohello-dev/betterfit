        "message": "<MetricPill> tone must be one of 'neutral' | 'accent' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MuscleChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:muscle|percent|tint|style|key|ref|className|style|children)$/]",
        "message": "<MuscleChip> doesn't accept that prop. Declared props: muscle, percent, tint, style."
