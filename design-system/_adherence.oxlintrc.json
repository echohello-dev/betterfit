        "selector": "JSXOpeningElement[name.name='RecoveryDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|size|style|key|ref|className|style|children)$/]",
        "message": "<RecoveryDot> doesn't accept that prop. Declared props: status, size, style."
